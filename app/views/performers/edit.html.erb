<div class="container mt-4">
<h1>演者の編集</h1>

<%= form_with model: @performer, local: true do |f|%>

  <div class="mb-3 w-25" >
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3 w-25">
    <%= f.label :height, "身長" %><br>
    <%= f.number_field :height, class: "form-control" %>
  </div>

  <div class="actions">
    <%= f.submit "更新する", class: "btn btn-primary" %>
    <%= link_to "キャンセル", performers_path, class: "btn btn-secondary" %>
  </div>
<% end %>