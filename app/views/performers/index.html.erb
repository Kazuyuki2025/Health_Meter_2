<div class="container mt-4">
  <h1 class="mb-4">演者一覧</h1>

  <% if @performers.present? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th class="fs-5">ID</th>
            <th class="fs-5">名前</th>
            <th class="fs-5">操作</th>
          </tr>
        </thead>
        <tbody>
          <% @performers.each do |performer| %>
            <tr>
              <td class="fs-4 fw-bold text-primary"><%= performer.num %></td>
              <td class="fs-4">
                <%= link_to performer.name, performer_path(performer), class: 'performer-link' %>
              </td>
              <td>
                <div class="d-flex gap-2">
                  <%= link_to '編集', edit_performer_path(performer), class: 'btn btn-warning btn-lg fs-5' %>
                  <%= button_to '削除', 
                      performer_path(performer), 
                      method: :delete, 
                      class: "btn btn-danger btn-lg fs-5",
                      data: { turbo_confirm: '本当に削除しますか？' } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info fs-4">
      <i class="fas fa-info-circle me-2"></i>
      演者が登録されていません。
    </div>
  <% end %>

  <div class="action-buttons mt-4">
    <%= link_to '新規演者登録', new_performer_path, class: 'btn btn-primary btn-lg fs-5 me-3' %>
    <%= link_to '動画一覧', videos_path, class: 'btn btn-secondary btn-lg fs-5' %>
  </div>
</div>

<style>
.performer-link {
  color: #007bff;
  text-decoration: none;
  font-weight: 600;
  font-size: 1.5rem;
}

.performer-link:hover {
  text-decoration: underline;
  color: #0056b3;
  transform: scale(1.05);
  transition: all 0.2s ease;
}

.table {
  font-size: 1.2rem;
}

.table td {
  padding: 1rem;
  vertical-align: middle;
}

.table th {
  padding: 1rem;
  font-weight: 700;
}

.action-buttons {
  text-align: center;
  padding: 2rem 0;
  border-top: 2px solid #e9ecef;
}

.btn-lg {
  padding: 0.75rem 1.5rem;
  font-weight: 600;
}

@media (max-width: 768px) {
  .fs-4 {
    font-size: 1.2rem !important;
  }
  
  .performer-link {
    font-size: 1.2rem;
  }
  
  .btn-lg {
    font-size: 1rem;
    padding: 0.5rem 1rem;
  }
}
</style>
