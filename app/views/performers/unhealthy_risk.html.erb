<%# app/views/performers/unhealthy_risk.html.erb %>
<div class="container mt-4">
  <h1 class="mb-4">⚠️ 体調不良の疑いがある演者</h1>

  <div class="action-buttons mb-4">
    <%= link_to '動画一覧', videos_path, class: 'btn btn-secondary btn-lg fs-5' %>
    <%= link_to '演者一覧', performers_path, class: 'btn btn-secondary btn-lg fs-5 ms-2' %>
    <%= link_to '元気ランキング', healthy_ranking_performers_path, class: 'btn btn-info btn-lg fs-5 ms-2' %>
  </div>

  <!-- リスクがある演者のみを表示 -->
  <% risk_performers = @performers_risk_data&.select { |data| data[:statistics][:low_z_count] > 0 } || [] %>
  
  <% if risk_performers.any? %>
    <div class="risk-performers-section mb-5">
      <h3 class="text-danger mb-3">
        <i class="fas fa-exclamation-triangle"></i> 
        体調不良リスクがある演者（<%= risk_performers.count %>名）
      </h3>
      
      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead class="table-danger">
            <tr>
              <th class="fs-5">演者名</th>
              <th class="fs-5">問題のある運動の数</th>
              <th class="fs-5">最新測定日</th>
              <th class="fs-5">詳細</th>
            </tr>
          </thead>
          <tbody>
            <% risk_performers.each_with_index do |performer_data, index| %>
              <% stats = performer_data[:statistics] %>
              <% risk_level = get_risk_level(stats[:low_z_count], stats[:total_categories]) %>
              <tr class="<%= get_risk_row_class(risk_level) %>">
                <td class="fs-4">
                  <%= link_to performer_data[:performer_name], 
                      performer_path(performer_data[:performer]), 
                      class: 'performer-link text-decoration-none' %>
                </td>
                <td class="fs-4 text-center">
                  <span class="badge bg-warning text-dark fs-6">
                    <%= stats[:low_z_count] %>
                  </span>
                </td>
                <td class="fs-5">
                  <%= stats[:latest_performance_date] %>
                </td>
                <td>
                  <%= link_to '詳細確認', 
                      performer_path(performer_data[:performer]), 
                      class: 'btn btn-outline-primary btn-sm' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="alert alert-success text-center">
      <h2><i class="fas fa-check-circle text-success"></i></h2>
      <p class="mb-0 fs-5">現在、体調不良リスクがある演者はいません。</p>
    </div>
  <% end %>

  <!-- 統計サマリー -->
  <div class="statistics-summary mt-4">
    <div class="row">
      <div class="col-md-3">
        <div class="card text-center border-success">
          <div class="card-body">
            <h5 class="card-title text-success">正常</h5>
            <% normal_count = (@performers_risk_data&.count { |data| data[:statistics] && data[:statistics][:low_z_count] == 0 } || 0) %>
            <h2 class="text-success"><%= normal_count %>名</h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center border-secondary">
          <div class="card-body">
            <h5 class="card-title text-secondary">データ不足</h5>
            <% no_data_count = (@all_performers_data&.count { |data| data[:statistics].nil? } || 0) %>
            <h2 class="text-secondary"><%= no_data_count %>名</h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center border-primary">
          <div class="card-body">
            <h5 class="card-title text-primary">全演者</h5>
            <h2 class="text-primary"><%= @all_performers_data&.count || 0 %>名</h2>
          </div>
        </div>
      </div>
    </div>
  </div>

<style>
.performer-link {
  color: #007bff;
  font-weight: 600;
}

.performer-link:hover {
  text-decoration: underline !important;
  color: #0056b3;
}

.table {
  font-size: 1.1rem;
}

.table td, .table th {
  padding: 1rem;
  vertical-align: middle;
}

.action-buttons {
  text-align: center;
  padding: 1rem 0;
}

/* リスクレベル別のスタイル */
.risk-high {
  background-color: #f8d7da !important;
}

.risk-medium {
  background-color: #fff3cd !important;
}

.risk-low {
  background-color: #d4edda !important;
}

.statistics-summary .card {
  margin-bottom: 1rem;
}

.statistics-summary .card-body {
  padding: 1.5rem;
}

.statistics-summary h2 {
  font-weight: 800;
  margin-bottom: 0;
}

.alert-success h2 {
  font-size: 3rem;
  margin-bottom: 1rem;
}
</style>

<%# ヘルパーメソッド用のスクリプト %>
<script>
<% content_for :javascript do %>
  <%# リスクレベル判定のヘルパーメソッドをRubyで定義 %>
<% end %>
</script>