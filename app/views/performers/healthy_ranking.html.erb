<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <h1 class="text-center mb-4 display-4 fw-bold text-black">🏆 元気ランキング</h1>

      <div class="ranking-list">
        <% @ranking_data.each_with_index do |performer_data, index| %>
          <div class="card mb-4 border-0 shadow-lg ranking-item rank-<%= index + 1 %> <%= 'border-warning' if index < 3 %>">
            <div class="card-body p-4">
              <div class="row align-items-center">
                <!-- Medal Section -->
                <div class="col-auto text-center">
                  <div class="rank-medal d-flex flex-column align-items-center">
                    <% if index == 0 %>
                      <span class="medal gold fs-1 mb-2">🥇</span>
                      <span class="badge bg-warning text-dark fw-bold fs-6 rank-number first">1位</span>
                    <% elsif index == 1 %>
                      <span class="medal silver fs-1 mb-2">🥈</span>
                      <span class="badge bg-secondary text-white fw-bold fs-6 rank-number second">2位</span>
                    <% elsif index == 2 %>
                      <span class="medal bronze fs-1 mb-2">🥉</span>
                      <span class="badge bg-warning text-dark fw-bold fs-6 rank-number third">3位</span>
                    <% else %>
                      <span class="badge bg-primary text-white fw-bold fs-5 rank-number other"><%= index + 1 %>位</span>
                    <% end %>
                  </div>
                </div>
                
                <!-- Performer Info Section -->
                <div class="col">
                  <div class="d-flex align-items-center mb-2">
                    <%= link_to performer_path(performer_data), class: "text-decoration-none performer-name rank-#{index + 1} me-3" do %>
                      <h3 class="mb-0 fw-bold <%= 'text-black' if index == 0 %> <%= 'text-black' if index == 1 %> <%= 'text-black' if index == 2 %> <%= 'text-primary' if index > 2 %>">
                        <%= performer_data.name %>
                      </h3>
                    <% end %>
                    <% if index < 3 %>
                      <span class="crown-effect fs-4">👑</span>
                    <% end %>
                  </div>
                  
                  <div class="d-flex align-items-baseline gap-2 mb-2">
                    <small class="text-muted fw-medium">活動量:</small>
                    <span class="badge <%= 'bg-warning text-dark' if index == 0 %> <%= 'bg-secondary' if index == 1 %> <%= 'bg-warning text-dark' if index == 2 %> <%= 'bg-primary' if index > 2 %> fs-5 fw-bold activity-score">
                      <%= performer_data.latest_avg_activity.round(2) %>
                    </span>
                  </div>
                  
                  <div class="text-muted">
                    <small class="fw-medium">日付: <%= performer_data.latest_date rescue "データなし" %></small>
                  </div>
                </div>
                
                <!-- Sparkle Effect Section -->
                <% if index < 3 %>
                  <div class="col-auto">
                    <div class="d-flex flex-column gap-1 sparkle-effect">
                      <span class="sparkle fs-4">✨</span>
                      <span class="sparkle fs-4">⭐</span>
                      <span class="sparkle fs-4">✨</span>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
/* カスタムアニメーション効果 */
.ranking-item {
  transition: transform 0.3s ease;
}

.ranking-item:hover {
  transform: translateY(-5px);
}

/* 1位の特別な光る効果 */
.ranking-item.rank-1 {
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 50%, #fff200 100%) !important;
  animation: goldGlow 3s ease-in-out infinite alternate;
}

@keyframes goldGlow {
  0% { box-shadow: 0 4px 15px rgba(255, 193, 7, 0.3); }
  100% { box-shadow: 0 8px 25px rgba(255, 193, 7, 0.6); }
}

/* メダルのバウンス効果 */
.medal {
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-10px); }
  60% { transform: translateY(-5px); }
}

/* 王冠の回転効果 */
.crown-effect {
  animation: rotate 3s linear infinite;
  display: inline-block;
}

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 1位の名前の光る効果 */
.performer-name.rank-1 h3 {
  animation: textGlow 2s ease-in-out infinite alternate;
}

@keyframes textGlow {
  0% { text-shadow: 2px 2px 4px rgba(255, 193, 7, 0.4); }
  100% { text-shadow: 4px 4px 8px rgba(255, 193, 7, 0.8); }
}

/* スパークル効果 */
.sparkle {
  animation: sparkleAnimation 1.5s ease-in-out infinite;
  display: inline-block;
}

.sparkle:nth-child(2) {
  animation-delay: 0.5s;
}

.sparkle:nth-child(3) {
  animation-delay: 1s;
}

@keyframes sparkleAnimation {
  0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.7; }
  50% { transform: scale(1.3) rotate(180deg); opacity: 1; }
}

/* レスポンシブ調整 */
@media (max-width: 768px) {
  .sparkle-effect {
    flex-direction: row !important;
    justify-content: center;
  }
}
</style>