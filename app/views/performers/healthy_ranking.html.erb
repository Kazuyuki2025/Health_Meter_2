<div class="container mt-4">
  <h1 class="mb-4">🏆 元気ランキング</h1>

  <div class="action-buttons mb-4">
    <%= link_to '動画一覧', videos_path, class: 'btn btn-secondary btn-lg fs-5' %>
    <%= link_to '演者一覧', performers_path, class: 'btn btn-secondary btn-lg fs-5 ms-2' %>
  </div>
  
  <div class="ranking-list">
    <% @ranking_data.each_with_index do |performer_data, index| %>
      <div class="ranking-item rank-<%= index + 1 %> mb-3">
        <div class="rank-medal">
          <% if index == 0 %>
            <span class="medal gold">🥇</span>
            <span class="rank-number first">1位</span>
          <% elsif index == 1 %>
            <span class="medal silver">🥈</span>
            <span class="rank-number second">2位</span>
          <% elsif index == 2 %>
            <span class="medal bronze">🥉</span>
            <span class="rank-number third">3位</span>
          <% else %>
            <span class="rank-number other"><%= index + 1 %>位</span>
          <% end %>
        </div>
        
        <div class="performer-info">
          <div class="performer-name-container">
            <span class="performer-name rank-<%= index + 1 %>">
              <%= performer_data.name %>
            </span>
            <% if index < 3 %>
              <div class="crown-effect">👑</div>
            <% end %>
          </div>
          <div class="performer-details">
            <span class="activity-label">平均活動量</span>
            <span class="activity-score rank-<%= index + 1 %>">
              <%= performer_data.avg_activity.round(2) %>
            </span>
            <span class="unit">pts</span>
          </div>
        </div>
        
        <div class="sparkle-effect">
          <% if index < 3 %>
            <span class="sparkle">✨</span>
            <span class="sparkle">⭐</span>
            <span class="sparkle">✨</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<style>
.ranking-list {
  max-width: 800px;
  margin: 0 auto;
  padding: 2rem 0;
}

.ranking-item {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border: 2px solid #e9ecef;
  border-radius: 20px;
  padding: 1.5rem 2rem;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.ranking-item:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}

/* 1位の特別スタイル */
.ranking-item.rank-1 {
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 50%, #fff200 100%);
  border: 3px solid #ffb000;
  animation: goldGlow 2s ease-in-out infinite alternate;
}

/* 2位の特別スタイル */
.ranking-item.rank-2 {
  background: linear-gradient(135deg, #c0c0c0 0%, #e8e8e8 50%, #d4d4d4 100%);
  border: 3px solid #a0a0a0;
}

/* 3位の特別スタイル */
.ranking-item.rank-3 {
  background: linear-gradient(135deg, #cd7f32 0%, #deb887 50%, #d2691e 100%);
  border: 3px solid #b8860b;
}

@keyframes goldGlow {
  0% { box-shadow: 0 8px 25px rgba(255, 215, 0, 0.3); }
  100% { box-shadow: 0 12px 35px rgba(255, 215, 0, 0.6); }
}

.rank-medal {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 2rem;
  min-width: 100px;
}

.medal {
  font-size: 3rem;
  margin-bottom: 0.5rem;
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-10px); }
  60% { transform: translateY(-5px); }
}

.rank-number {
  font-weight: 800;
  font-size: 1.2rem;
  text-align: center;
}

.rank-number.first {
  color: #ff6b35;
  text-shadow: 2px 2px 4px rgba(255, 107, 53, 0.3);
  font-size: 1.4rem;
}

.rank-number.second {
  color: #6c757d;
  text-shadow: 2px 2px 4px rgba(108, 117, 125, 0.3);
  font-size: 1.3rem;
}

.rank-number.third {
  color: #8b4513;
  text-shadow: 2px 2px 4px rgba(139, 69, 19, 0.3);
  font-size: 1.2rem;
}

.rank-number.other {
  color: #495057;
  font-size: 1.5rem;
}

.performer-info {
  flex-grow: 1;
  margin-left: 1rem;
}

.performer-name-container {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 0.5rem;
}

.performer-name {
  font-size: 2rem;
  font-weight: 700;
  margin-right: 1rem;
  text-decoration: none;
  transition: all 0.3s ease;
}

.performer-name.rank-1 {
  color: #ff6b35;
  text-shadow: 3px 3px 6px rgba(255, 107, 53, 0.4);
  font-size: 2.5rem;
  animation: textGlow 2s ease-in-out infinite alternate;
}

.performer-name.rank-2 {
  color: #6c757d;
  text-shadow: 2px 2px 4px rgba(108, 117, 125, 0.4);
  font-size: 2.2rem;
}

.performer-name.rank-3 {
  color: #8b4513;
  text-shadow: 2px 2px 4px rgba(139, 69, 19, 0.4);
  font-size: 2.1rem;
}

@keyframes textGlow {
  0% { text-shadow: 3px 3px 6px rgba(255, 107, 53, 0.4); }
  100% { text-shadow: 5px 5px 10px rgba(255, 107, 53, 0.8); }
}

.crown-effect {
  font-size: 1.5rem;
  animation: rotate 3s linear infinite;
}

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.performer-details {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
}

.activity-label {
  font-size: 0.9rem;
  color: #6c757d;
  font-weight: 500;
}

.activity-score {
  font-size: 1.8rem;
  font-weight: 800;
  padding: 0.3rem 0.8rem;
  background: rgba(255,255,255,0.8);
  border-radius: 12px;
  border: 2px solid #e9ecef;
}

.activity-score.rank-1 {
  color: #ff6b35;
  border-color: #ff6b35;
  background: rgba(255, 107, 53, 0.1);
}

.activity-score.rank-2 {
  color: #6c757d;
  border-color: #6c757d;
  background: rgba(108, 117, 125, 0.1);
}

.activity-score.rank-3 {
  color: #8b4513;
  border-color: #8b4513;
  background: rgba(139, 69, 19, 0.1);
}

.unit {
  font-size: 1rem;
  color: #6c757d;
  font-weight: 600;
}

.sparkle-effect {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-left: 1rem;
}

.sparkle {
  font-size: 1.5rem;
  animation: sparkleAnimation 1.5s ease-in-out infinite;
}

.sparkle:nth-child(2) {
  animation-delay: 0.5s;
}

.sparkle:nth-child(3) {
  animation-delay: 1s;
}

@keyframes sparkleAnimation {
  0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.7; }
  50% { transform: scale(1.2) rotate(180deg); opacity: 1; }
}

.action-buttons {
  text-align: center;
  padding: 1rem 0;
}

@media (max-width: 768px) {
  .ranking-item {
    flex-direction: column;
    text-align: center;
    padding: 1rem;
  }
  
  .rank-medal {
    margin-right: 0;
    margin-bottom: 1rem;
  }
  
  .performer-name {
    font-size: 1.5rem !important;
  }
  
  .performer-name.rank-1 {
    font-size: 1.8rem !important;
  }
  
  .sparkle-effect {
    flex-direction: row;
    justify-content: center;
    margin-left: 0;
    margin-top: 1rem;
  }
}
</style>