<div class="container mt-4">
  <!-- ページヘッダー -->
  <div class="border-bottom pb-3 mb-4">
    <h1 class="display-5 fw-bold text-primary"><%= @video.title %></h1>
    <p class="text-muted mb-0">
      <i class="fas fa-calendar-alt me-2"></i>
      アップロード日: <%= @video.created_at.strftime("%Y年%m月%d日 %H:%M") %>
    </p>
  </div>
  
  <!-- 動画プレイヤー -->
  <% if @video.content.attached? && @video.analysis_status == 'completed' %>
    <div class="text-center bg-light p-4 rounded-3 mb-4">
      <video controls class="img-fluid rounded shadow" style="max-width: 800px;">
        <source src="<%= rails_blob_path(@video.content, disposition: "inline") %>" type="video/mp4">
      </video>
      <div class="mt-3">
        <%= link_to player_video_path(@video), class: "btn btn-primary btn-lg" do %>
          <i class="fas fa-play-circle me-2"></i>
          Bounding Boxを表示して再生
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- 解析状況表示 -->
  <% if @video.analysis_status == 'pending' || @video.analysis_status == 'analyzing' %>
    <div class="alert alert-info d-flex align-items-center mb-4">
      <i class="fas fa-clock me-3 fs-4"></i>
      <div>
        <h5 class="alert-heading mb-2">解析状況</h5>
        <% if @video.analysis_status == 'pending' %>
          <p class="mb-0">解析待ちです。演者の紐付けが完了すると解析が開始されます。</p>
        <% else %>
          <div class="d-flex align-items-center">
            <div class="spinner-border spinner-border-sm me-2" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <span>現在解析中です。しばらくお待ちください...</span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- 顔検出結果と演者選択フォーム -->
  <% if @detected_ids.present? && @video.analysis_status == 'pending' %>
    <div class="card border-success shadow-sm mb-4">
      <div class="card-header bg-success text-white">
        <h4 class="card-title mb-0">
          <i class="fas fa-users me-2"></i>
          検出された人数: <%= @detected_ids.size %>人
        </h4>
      </div>
      <div class="card-body">
        <!-- サムネイル表示 -->
        <% if @video.thumbnail.attached? %>
          <div class="text-center mb-4">
            <%= image_tag rails_blob_path(@video.thumbnail, disposition: "inline"), 
                          alt: "動画のサムネイル", 
                          class: "img-fluid rounded border shadow-sm",
                          style: "max-width: 800px;" %>
          </div>
        <% end %>

        <!-- 演者選択フォーム -->
        <%= form_with url: assign_performers_video_path(@video), method: :post, local: true do |performer_form| %>
          <h5 class="mb-3">IDと演者を紐付けてください</h5>
          
          <div class="row g-3">
            <% @detected_ids.each_with_index do |detected_id, index| %>
              <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                  <div class="card-body">
                    <h6 class="card-title text-primary">
                      <i class="fas fa-tag me-2"></i>
                      検出ID <%= detected_id %>
                    </h6>
                    <%= select_tag "performer_assignments[#{detected_id}]",
                                   options_from_collection_for_select(Performer.all, :id, :name, nil),
                                   { include_blank: "演者を選択してください", 
                                     class: "form-select",
                                     id: "performer_assignments_#{detected_id}" } %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
          
          <div class="text-center mt-4">
            <%= performer_form.submit "演者を紐付けて分析開始", class: "btn btn-success btn-lg px-5" %>
            <p class="text-muted small mt-2 mb-0">
              <i class="fas fa-info-circle me-1"></i>
              演者の紐付け後、バックグラウンドで動画の詳細分析が開始されます
            </p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- 解析完了時の結果表示 -->
  <% if @video.analysis_status == 'completed' && @activity_data.any? %>

    <!-- 出演者一覧 -->
    <div class="card">
      <div class="card-header bg-light">
        <h4 class="card-title mb-0">
          <i class="fas fa-users me-2"></i>出演者一覧
        </h4>
      </div>
      <div class="card-body">
        
        <div class="row g-3">
          <% @activity_data.each_with_index do |data, index| %>
            <% performer = data[:performer] if data %>
            <% performance_id = data[:performance_id] if data %>
            <% avg_activity = data[:average] if data %>  

            <div class="col-md-6 col-lg-4">
              <div class="card border-primary h-100">
                <div class="card-body">
                  <div class="d-flex align-items-center mb-3">
                    <div class="badge bg-primary fs-6 me-3">ID: <%= index + 1 %></div>
                    <div class="flex-grow-1">
                      <% if performer %>
                        <%= link_to performer.name, video_performance_path(@video, performance_id), 
                                    class: "btn btn-outline-primary btn-sm" %>
                      <% else %>
                        <span class="text-muted">未割り当て</span>
                      <% end %>
                    </div>
                  </div>
                  <% if avg_activity.present? %>
                    <div class="mb-2">
                      <div class>平均活動量:
                        <%= avg_activity.round(2) %>
                      </div>
                   </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  <% elsif @video.analysis_status == 'completed' && @activity_data.empty? %>
    <div class="alert alert-warning d-flex align-items-center">
      <i class="fas fa-exclamation-triangle me-3 fs-4"></i>
      <div>
        <h5 class="alert-heading mb-1">解析完了</h5>
        <p class="mb-0">解析は完了しましたが、活動量データが見つかりません。</p>
      </div>
    </div>
  <% end %>

  <!-- ナビゲーション -->
  <div class="d-flex gap-2 justify-content-center border-top pt-4 mt-4">
    <%= link_to videos_path, class: 'btn btn-secondary' do %>
      <i class="fas fa-arrow-left me-2"></i>動画一覧へ戻る
    <% end %>
    <%= link_to edit_video_path(@video), class: 'btn btn-outline-primary' do %>
      <i class="fas fa-edit me-2"></i>編集
    <% end %>
  </div>
</div>
