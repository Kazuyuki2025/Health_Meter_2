<div class="container mt-4 mb-5">
  <h1>動画一覧</h1>
</div>

<% if @videos.any? %>
  <div class="container">
    <div class="row">
      <% @videos.each do |video| %>
        <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
          <div class="card">
            <div class="card-title">
            <% if video.thumbnail.attached? %>
              <%= link_to video_path(video) do %>
                <%= image_tag video.thumbnail, class: "card-img-top", style: "max-height: 300px; object-fit: cover;" , alt: video.title %>
              <% end %>
            <% end %>
            </div>

            <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div class="video-info">
                <h4><%= link_to video.title, video_path(video), class: "text-decoration-none" %></h4>
                <div class="video-meta mt-2 d-flex align-items-center flex-wrap">
                  <% if video.date.present? %>
                    <div class="video-info me-2">
                      <strong>撮影日:</strong> <%= video.date.strftime("%Y年%m月%d日") %>
                    </div>
                  <% end %>
                  <span class="badge bg-<%= status_color(video.analysis_status) %> me-2">
                    <i class="fas fa-<%= status_icon(video.analysis_status) %>"></i>
                    <%= status_text(video.analysis_status) %>
                  </span>
                  <small class="text-muted">
                    <%= video.created_at.strftime("%Y年%m月%d日 %H:%M") %>
                  </small>
                </div>
              </div>
            </div>
            
            <div class="video-actions mb-3">
              <%= link_to "編集", edit_video_path(video), class: "btn btn-secondary btn-sm me-2" %>
              <%= button_to "削除", 
                  video_path(video), 
                  method: :delete,
                  class: "btn btn-danger btn-sm",
                  data: { turbo_confirm: "本当に削除しますか？" } %>
            </div>
            
            <!-- 詳細情報 -->
            <div class="video-details">
              <% case video.analysis_status %>
              <% when 'pending' %>
                <div class="d-flex flex-column">
                  <p class="text-muted mb-2">
                    <i class="fas fa-clock"></i> 
                    演者の紐付けが完了すると解析が開始されます
                  </p>
                  <%= button_to "再解析", reanalyze_video_path(video), 
                      method: :post,
                      class: "btn btn-warning btn-sm",
                      title: "顔検出を再実行します",
                      data: { 
                        turbo: false,
                        turbo_confirm: "再解析を実行しますか？既存のデータは削除されます。"
                      } %>
                </div>
              <% when 'analyzing' %>
                <p class="text-warning mb-0">
                  <i class="fas fa-spinner fa-spin"></i> 
                  現在解析中です...
                </p>
              <% when 'completed' %>
                <p class="text-success mb-0">
                  <i class="fas fa-check-circle"></i> 
                  解析完了 - 
                  <% performer_count = video.performances.count %>
                  <%= performer_count %>名の演者が検出されました
                </p>
              <% when 'failed' %>
                <p class="text-danger mb-0">
                  <i class="fas fa-exclamation-triangle"></i> 
                  解析に失敗しました
                </p>
              <% end %>
            </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="container">
    <div class="alert alert-info">
      <h4><i class="fas fa-info-circle"></i> 動画がありません</h4>
      <p>まだ動画がアップロードされていません。</p>
    </div>
  </div>
<% end %>

<style>
.video-item {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border: 1px solid #e9ecef !important;
  transition: all 0.3s ease;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.video-item:hover {
  border-color: #007bff !important;
  box-shadow: 0 4px 12px rgba(0,123,255,0.15);
  transform: translateY(-2px);
}

.video-actions {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.action-buttons {
  text-align: center;
  padding: 2rem 0;
  border-top: 2px solid #e9ecef;
}

</style>
