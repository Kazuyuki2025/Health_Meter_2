<div class="video-player-container">
  <!-- ヘッダー -->
  <div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h3 class="mb-1"><%= @video.title %></h3>
      </div>
      <div>
        <%= link_to video_path(@video), class: "btn btn-sm btn-outline-secondary" do %>
          <i class="fas fa-arrow-left me-1"></i>戻る
        <% end %>
      </div>
    </div>
  </div>

  <!-- 動画プレイヤー -->
  <div class="video-wrapper">
    <video id="videoPlayer" 
           controls
           data-video-id="<%= @video.id %>"
           class="w-100">
      <% if @video.content.attached? %>
        <source src="<%= rails_blob_path(@video.content, disposition: "inline") %>" type="video/mp4">
      <% end %>
    </video>
    
    <!-- Bounding Box描画用のCanvas -->
    <canvas id="bboxCanvas"></canvas>
  </div>
  
  <!-- コントロールパネル -->
  <div class="controls-panel">
    <div class="row g-3">
      <div class="col-md-6">
        <h6 class="mb-2 text-muted">表示設定</h6>
        <div class="btn-group w-100" role="group">
          <button id="toggleBbox" class="btn btn-primary">
            Bounding Box 非表示
          </button>
          <button id="toggleLabels" class="btn btn-outline-primary">
            ラベル 非表示
          </button>
        </div>
      </div>
      
      <div class="col-md-6">
        <h6 class="mb-2 text-muted">再生情報</h6>
        <div class="d-flex gap-2 flex-wrap">
          <span id="frameInfo" class="badge bg-secondary">Frame: 0</span>
          <span id="detectionCount" class="badge bg-success">検出: 0人</span>
          <span id="timeInfo" class="badge bg-info">Time: 00:00</span>
        </div>
      </div>
    </div>
  </div>
<style>
.video-player-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 20px;
}

.video-wrapper {
  position: relative;
  display: inline-block;
  width: 100%;
  background: #000;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

#videoPlayer {
  display: block;
  width: 100%;
}

#bboxCanvas {
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none;
}

.controls-panel {
  margin-top: 20px;
  padding: 20px;
  background: #f8f9fa;
  border: 1px solid #dee2e6;
  border-radius: 8px;
}

.controls-panel .btn-group {
  width: 100%;
}

.controls-panel .btn {
  flex: 1;
}

.stats-card {
  background: white;
  border: 1px solid #dee2e6;
  border-radius: 8px;
  padding: 15px;
  text-align: center;
  transition: all 0.2s;
}

.stats-card:hover {
  border-color: #0d6efd;
  box-shadow: 0 2px 8px rgba(13, 110, 253, 0.1);
}

.stats-card .stats-value {
  font-size: 1.75rem;
  font-weight: 700;
  color: #212529;
  margin-bottom: 0.25rem;
}

.stats-card .stats-label {
  font-size: 0.875rem;
  color: #6c757d;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

@media (max-width: 768px) {
  .video-player-container {
    padding: 10px;
  }
  
  .controls-panel .btn-group {
    flex-direction: column;
  }
}
</style>

<%= javascript_import_module_tag "video_player" %>